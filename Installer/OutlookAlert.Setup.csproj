<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>OutlookAlert-Setup</AssemblyName>
    <RootNamespace>OutlookAlert.Setup</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../Packaging/Assets/App.ico</ApplicationIcon>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>Outlook Alert Setup</AssemblyTitle>
    <Product>Outlook Alert</Product>
    <Company>facoding</Company>
    <Authors>facoding</Authors>
    <Copyright>Copyright (c) 2026 facoding</Copyright>
    <Description>Installs the Outlook-only desktop notification listener.</Description>
    <Version>3.1.0</Version>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Management" />
    <Reference Include="System.Security" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.IO.Compression" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../Payload/OutlookAlert.msix" LogicalName="OutlookAlert.Setup.Payload.msix" Condition="Exists('../Payload/OutlookAlert.msix')" />
    <EmbeddedResource Include="../Payload/OutlookAlert.cer" LogicalName="OutlookAlert.Setup.Publisher.cer" Condition="Exists('../Payload/OutlookAlert.cer')" />
    <EmbeddedResource Include="../Payload/OutlookAlert-Launcher.exe" LogicalName="OutlookAlert.Setup.UserLauncher.exe" Condition="Exists('../Payload/OutlookAlert-Launcher.exe')" />
  </ItemGroup>
</Project>
