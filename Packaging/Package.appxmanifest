<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
         xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap uap3 desktop rescap">
  <Identity Name="Faraz.OutlookAlert" Version="3.0.1.0"
            Publisher="CN=Faraz Outlook Alert" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Outlook Alert</DisplayName>
    <PublisherDisplayName>facoding</PublisherDisplayName>
    <Description>Persistent Outlook notification alerts on every connected display.</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Resources><Resource Language="en-us" /></Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Applications>
    <Application Id="App" Executable="OutlookAlert.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Outlook Alert"
                          Description="Persistent Outlook notification alerts on every display."
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png"
                          BackgroundColor="transparent" />
      <Extensions>
        <desktop:Extension Category="windows.startupTask" Executable="OutlookAlert.exe"
                           EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="OutlookAlertStartup" Enabled="false" DisplayName="Outlook Alert" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <uap3:Capability Name="userNotificationListener" />
  </Capabilities>
</Package>
